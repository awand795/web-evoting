# MongoDB local
MONGODB_URI=mongodb://localhost:27017/db_evoting

# MongoDB Atlas (jika pakai cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/db_evoting?retryWrites=true&w=majority

# JWT secret key - gunakan string random yang panjang
JWT_SECRET=ganti_dengan_secret_key_yang_kuat_dan_random

# URL base untuk file upload (sesuaikan jika deploy ke server)
BASE_URL=http://localhost:5000/files/

# Port server (opsional, default 5000)
PORT=5000
